# .agents/ is Codex's skill root: local state, with nothing tracked here.
.agents/

# .claude/ is local state (settings.local.json, caches) with exceptions: the
# skills that encode this repository's own process. Git will not descend into an
# ignored directory, so every parent has to be re-included before the leaf.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/make-repo-contribution/

# design generation logs
designs/**/*.log

