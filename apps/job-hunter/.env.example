# Job Hunter environment variables, grouped by the surface that needs them.
#
# Two runtimes read this app's configuration and they need different subsets:
#
#   * the daily pipeline (GitHub Actions, `.github/workflows/job-hunter-*.yml`,
#     or a local run), and
#   * the Telegram webhook (Vercel, `main.py`).
#
# Copy this file to `.env`, fill in the groups your runtime needs, then
# `set -a; source .env; set +a` before running locally. Values with a code
# default are listed under "Optional overrides" and are safe to leave blank.
#
# The Gemini API key (required), the Brave Search API key (optional) and the CV
# and cover letter text are NOT environment variables. They are per-user values
# saved in Relay's Profile view for the account named by JOB_HUNTER_USER_ID, and
# the pipeline reads them from Postgres at run time. See README.md.


# --- Supabase: required by both runtimes (issue #69) ---
# The pipeline stores all of its state in this project's Postgres database and
# reads the acting user's configuration from it.
#
# JOB_HUNTER_USER_ID is the UUID of the platform user a run acts for.
# SUPABASE_SIGNING_KEY_B64 is the base64-encoded private JWK of the project's
# ES256 signing key. It mints the trusted runner tokens a run acts with, and it
# can mint one for any user: treat it as the platform's most sensitive secret.
JOB_HUNTER_USER_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SIGNING_KEY_B64=


# --- The crawl's direct database connection (issue #182) ---
# SUPABASE_DB_URL is the project's **session pooler** connection string -- the
# same one .github/workflows/supabase-migrations.yml pushes migrations with.
# Ingestion holds it as a pooled, privileged connection so that a crawl can
# COPY a batch of listings into staging and merge them with one set-based
# statement, which PostgREST cannot express. It is used ONLY for the shared
# postings tables, which have no user dimension; matching, delivery and every
# per-user read keep PostgREST and row-level security exactly as they are.
#
# Optional. Leave it blank and a run persists each posting inside its own job
# upsert, one round trip at a time: slower, and identical in what it delivers.
# It is a privileged credential -- treat it like SUPABASE_SIGNING_KEY_B64.
SUPABASE_DB_URL=


# --- Required by the daily pipeline ---
# Gmail OAuth, for reading recruiter mail.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Telegram delivery. Both are required unless JOB_HUNTER_DRY_RUN is set, which
# skips delivery entirely (see the optional overrides below).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# --- Required by the Telegram webhook (Vercel) ---
# TELEGRAM_BOT_TOKEN above is shared with the daily pipeline; the webhook needs
# it too. GITHUB_DISPATCH_TOKEN is the token the webhook dispatches workflow
# runs with, and is separate from GITHUB_REPOSITORY's own permissions.
TELEGRAM_WEBHOOK_SECRET=
GITHUB_REPOSITORY=amitbaz/career-platform
GITHUB_DISPATCH_TOKEN=


# --- The platform key (issue #128) ---
# The deployment's own Gemini key, which funds objective facet extraction:
# reading a posting once, for every user. It is not a per-user credential and
# so is not in Relay Profile -- one key pays for work that belongs to nobody in
# particular.
#
# Leaving it blank is safe but not harmless. A run then reads no postings at
# all, and since scoring is fed a posting's facets rather than its description,
# no newly discovered job can be scored: the run completes, warns, queues those
# jobs, and delivers only what earlier runs already enriched. Set this if you
# want a digest.
#
# It never falls back to the user's own key, on any path, including an
# exhausted allowance -- that is the whole point of the separation, so do not
# "fix" a blank value by pointing it at a user's key.
PLATFORM_GEMINI_API_KEY=


# --- Optional overrides ---
# Every variable below has a code default. Leave it blank to take the default;
# the default is stated in the comment rather than in the value, so this file
# cannot drift away from the code.

# Gemini model the pipeline calls. Default: gemini-3.5-flash-lite
GEMINI_MODEL=

# Free-tier limits the run must stay inside. All three are optional: the
# published limits for GEMINI_MODEL are defaults in code, and a model with no
# entry there falls back to the most conservative known limits and logs that
# it did. Set one of these only to override that dimension -- for a project
# whose limits are not the published ones, or an entry that has gone stale.
# The provider's own 429 remains the binding limit either way.
GEMINI_FREE_RPM=
GEMINI_FREE_TPM=
GEMINI_FREE_RPD=

# Brave Search queries the pipeline may spend in a calendar month. Default:
# 1000. An invalid or non-positive value disables Brave rather than falling
# back to the default, so a typo cannot silently spend the whole budget.
BRAVE_MONTHLY_QUERY_LIMIT=

# Wall-clock seconds any one job source may spend before discovery cuts it off
# between its units of work. Default: 1800. A value of 0, a negative number, a
# non-finite float or a typo is ignored in favour of that default, so a
# misconfiguration can neither cut every source off at its first unit nor
# silently disable the budget.
JOB_HUNTER_SOURCE_TIME_BUDGET_SECONDS=

# Directory the run writes its output files to. Default: var
JOB_HUNTER_OUTPUT_DIR=

# Skip Telegram delivery, so a local run needs no Telegram credentials.
# Truthy values are 1/true/yes (case-insensitive); anything else counts as
# unset. Default: unset (delivery enabled).
JOB_HUNTER_DRY_RUN=
