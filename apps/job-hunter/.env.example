# Daily GitHub Actions / local bot runtime
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GEMINI_MODEL=gemini-3.6-flash
BRAVE_MONTHLY_QUERY_LIMIT=250
# Wall-clock seconds any one job source may spend before discovery cuts it off
# between its units of work. Unset means the generous default (1800). A value
# of 0, a negative number, a non-finite float or a typo is ignored in favour of
# that default, so a misconfiguration can neither cut every source off at its
# first unit nor silently disable the budget.
JOB_HUNTER_SOURCE_TIME_BUDGET_SECONDS=
JOB_HUNTER_DB_PATH=var/job_hunter.sqlite3
JOB_HUNTER_DRY_RUN=

# The Gemini API key (required), the Brave Search API key (optional) and the
# CV and cover letter text are per-user values, not environment variables.
# Save them in Relay's Profile view for the account named by JOB_HUNTER_USER_ID;
# the pipeline reads them from Postgres at run time. See README.md.

# Telegram webhook server-side runtime (Vercel today)
# TELEGRAM_BOT_TOKEN is shared with the daily bot runtime.
TELEGRAM_WEBHOOK_SECRET=
GITHUB_REPOSITORY=amitbaz/career-platform
GITHUB_STATE_TOKEN=
GITHUB_DISPATCH_TOKEN=
GITHUB_STATE_ARTIFACT_NAME=job-hunter-state
GITHUB_STATE_CACHE_DIR=/tmp/job-hunter-state

# Supabase (issue #69). The pipeline stores all of its state in this project's
# Postgres database and reads the acting user's configuration from it.
# JOB_HUNTER_USER_ID is the UUID of the platform user a run acts for.
# SUPABASE_SIGNING_KEY_B64 is the base64-encoded private JWK of the project's
# ES256 signing key. It mints the trusted runner tokens a run acts with, and it
# can mint one for any user: treat it as the platform's most sensitive secret.
JOB_HUNTER_USER_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SIGNING_KEY_B64=
