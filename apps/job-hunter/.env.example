# Daily GitHub Actions / local bot runtime
GEMINI_API_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CANDIDATE_PROFILE_B64=
COVER_LETTER_TEMPLATE_B64=
GEMINI_MODEL=gemini-3.6-flash
BRAVE_SEARCH_API_KEY=
BRAVE_MONTHLY_QUERY_LIMIT=250
JOB_HUNTER_DB_PATH=var/job_hunter.sqlite3
JOB_HUNTER_DRY_RUN=

# Telegram webhook server-side runtime (Vercel today)
# TELEGRAM_BOT_TOKEN is shared with the daily bot runtime.
TELEGRAM_WEBHOOK_SECRET=
GITHUB_REPOSITORY=amitbaz/career-platform
GITHUB_STATE_TOKEN=
GITHUB_DISPATCH_TOKEN=
GITHUB_STATE_ARTIFACT_NAME=job-hunter-state
GITHUB_STATE_CACHE_DIR=/tmp/job-hunter-state

# Supabase (issue #69). Not yet used by the pipeline — the store port is #70.
# JOB_HUNTER_USER_ID is the UUID of the platform user a run acts for.
# SUPABASE_SIGNING_KEY_B64 is the base64-encoded private JWK of the project's
# ES256 signing key. It mints tokens for any user: treat it as the platform's
# most sensitive secret.
JOB_HUNTER_USER_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SIGNING_KEY_B64=
