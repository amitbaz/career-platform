# Daily GitHub Actions / local bot runtime
GEMINI_API_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CANDIDATE_PROFILE_B64=
COVER_LETTER_TEMPLATE_B64=
GEMINI_MODEL=gemini-3.6-flash
BRAVE_SEARCH_API_KEY=
BRAVE_MONTHLY_QUERY_LIMIT=250
