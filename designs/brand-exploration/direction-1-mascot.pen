                  "name": "VOICE Rule",
                  "fill": "$brand",
                  "width": 56,
                  "height": 3
                },
                {
                  "type": "text",
                  "id": "sEMjp",
                  "name": "VOICE Title",
                  "fill": "$ink",
                  "content": "VOICE",
                  "fontFamily": "$font-body",
                  "fontSize": 11,
                  "fontWeight": "600",
                  "letterSpacing": 1.4
                },
                {
                  "type": "text",
                  "id": "QEC6a",
                  "name": "VOICE Body",
                  "fill": "$ink-soft",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Warm, plain, second person. Short sentences. The character speaks in the product; the brand speaks on the site. Never chirpy about a rejection — the mascot goes quiet and the copy gets shorter, not more upbeat.",
                  "lineHeight": 1.6,
                  "fontFamily": "$font-body",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "i1nBE",
              "name": "WHERE THE CHARACTER LIVES",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 10,
              "padding": [
                24,
                0,
                0,
                0
              ],
              "children": [
                {
                  "type": "rectangle",
                  "cornerRadius": 999,
                  "id": "xcsb7",
                  "name": "WHERE THE CHARACTER LIVES Rule",
                  "fill": "$brand",
                  "width": 56,
                  "height": 3
                },
                {
                  "type": "text",
                  "id": "J7WjX4",
                  "name": "WHERE THE CHARACTER LIVES Title",
                  "fill": "$ink",
                  "content": "WHERE THE CHARACTER LIVES",
                  "fontFamily": "$font-body",
                  "fontSize": 11,
                  "fontWeight": "600",
                  "letterSpacing": 1.4
                },
                {
                  "type": "text",
                  "id": "blJ2n",
                  "name": "WHERE THE CHARACTER LIVES Body",
                  "fill": "$ink-soft",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Ads, landing page, empty states, streaks, results and rejections. It stays out of the CV editor, the job list and anything the user is concentrating in — presence there would read as a toy.",
                  "lineHeight": 1.6,
                  "fontFamily": "$font-body",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "ApD2o",
              "name": "RISKS TO WATCH",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 10,
              "padding": [
                24,
                0,
                0,
                0
              ],
              "children": [
                {
                  "type": "rectangle",
                  "cornerRadius": 999,
                  "id": "art0M",
                  "name": "RISKS TO WATCH Rule",
                  "fill": "$brand",
                  "width": 56,
                  "height": 3
                },
                {
                  "type": "text",
                  "id": "CgOJq",
                  "name": "RISKS TO WATCH Title",
                  "fill": "$ink",
                  "content": "RISKS TO WATCH",
                  "fontFamily": "$font-body",
                  "fontSize": 11,
                  "fontWeight": "600",
                  "letterSpacing": 1.4
                },
                {
                  "type": "text",
                  "id": "yFK0W",
                  "name": "RISKS TO WATCH Body",
                  "fill": "$ink-soft",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A character can read junior to senior candidates and to recruiters. Test the same ad with and without it. Second risk: a mascot is expensive to keep — every new state needs new artwork, so the pose set must be finite and defined early.",
                  "lineHeight": 1.6,
                  "fontFamily": "$font-body",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        }
