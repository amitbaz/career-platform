                {
                  "type": "text",
                  "id": "KXbcr",
                  "name": "Cast Note",
                  "fill": "$ink-soft",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The cast is deliberately wide: a school leaver, a shift worker, a parent returning, someone changing trade at fifty. Figures are drawn at the same scale and the same warmth — nobody is the exception. One figure per scene, always mid-step, never celebrating alone.",
                  "lineHeight": 1.6,
                  "fontFamily": "$font-body",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
