                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "We do the hunt. We get you ready. You walk in prepared.",
                      "lineHeight": 1.25,
                      "fontFamily": "$font-display",
                      "fontSize": 30,
                      "fontWeight": "700",
                      "letterSpacing": -0.6
